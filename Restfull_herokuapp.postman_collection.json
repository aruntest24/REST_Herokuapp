    "_exporter_id": "12219749"
  },
  "item": [
    {
      "name": "Auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\"token\",\"token=\"+jsonData.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"BaseURL\",\"https://restful-booker.herokuapp.com\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURL}}/auth",
          "host": [
            "{{BaseURL}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create a booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\"bookingid\", jsonData.bookingid);\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"firstName\", pm.iterationData.get(\"FirstName\"));\r",
              "pm.collectionVariables.set(\"lastName\", pm.iterationData.get(\"LastName\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"{{firstName}}\",\r\n  \"lastname\": \"{{lastName}}\",\r\n  \"totalprice\": 1500,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2026-11-01\",\r\n    \"checkout\": \"2026-11-05\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURL}}/booking",
          "host": [
            "{{BaseURL}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Read the booking",
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Arun\",\r\n  \"lastname\": \"Kumar\",\r\n  \"totalprice\": 1500,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2026-11-01\",\r\n    \"checkout\": \"2026-11-05\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}"
        },
        "url": {
          "raw": "{{BaseURL}}/booking/{{bookingid}}",
          "host": [
            "{{BaseURL}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update all booking fields",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"updatedTotalPrice\",pm.iterationData.get(\"UpdatedTotalPrice\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"{{firstName}}\",\r\n  \"lastname\": \"{{lastName}}\",\r\n  \"totalprice\": {{updatedTotalPrice}},\r\n  \"depositpaid\": false,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2026-11-01\",\r\n    \"checkout\": \"2026-11-05\"\r\n  },\r\n  \"additionalneeds\": \"Lunch\"\r\n}"
        },
        "url": {
          "raw": "{{BaseURL}}/booking/{{bookingid}}",
          "host": [
            "{{BaseURL}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Updated selected fields",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"updatedLastName\", pm.iterationData.get(\"UpdatedLastName\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Cookie",
            "value": "{{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"lastname\": \"{{updatedLastName}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURL}}/booking/{{bookingid}}",
          "host": [
            "{{BaseURL}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete the booking",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Cookie",
            "value": "{{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BaseURL}}/booking/{{bookingid}}",
          "host": [
            "{{BaseURL}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      },
      "response": []
    }
